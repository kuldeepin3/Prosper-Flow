# Database configuration
# Use sqlite:///./financial_tracker.db for local SQLite
# Use postgresql://user:password@host:port/dbname for PostgreSQL
DATABASE_URL=sqlite:///./financial_tracker.db

# Security
# Run `openssl rand -hex 32` or similar to generate a secure secret key
JWT_SECRET=antigravity-super-secret-key-12345!!!

# CORS Settings (comma-separated list of allowed origins)
# Use * for development or specific domains for production
CORS_ORIGINS=*

# AI Service Settings
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDINGS_TIMEOUT=10.0
